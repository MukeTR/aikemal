{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "aikemal",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "env": {
    "preview": {
      "name": "aikemal-preview",
      "assets": {
        "directory": "../web/dist",
        "binding": "ASSETS",
        "not_found_handling": "single-page-application",
        "run_worker_first": ["/api", "/api/*"],
      },
    },
    "production": {
      "name": "aikemal",
      "routes": [{ "pattern": "aikemal.com", "custom_domain": true }],
      "assets": {
        "directory": "../web/dist",
        "binding": "ASSETS",
        "not_found_handling": "single-page-application",
        "run_worker_first": ["/api", "/api/*"],
      },
    },
  },
}
